:root{--bg:#07090c;--card:#11151b;--line:#1f2733;--tx:#e8edf4;--mut:#96a3b4;--acc:#5fe08a;--acc2:#4da3ff}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font-family:Inter,system-ui,-apple-system,sans-serif;line-height:1.6}
.wrap{max-width:1040px;margin:0 auto;padding:0 22px}
header{padding:26px 0;border-bottom:1px solid var(--line);position:sticky;top:0;background:rgba(7,9,12,.92);backdrop-filter:blur(10px);z-index:9}
header .wrap{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.brand{font-weight:800;letter-spacing:-.02em}.brand span{color:var(--acc)}
.nav a{color:var(--mut);text-decoration:none;margin-left:16px;font-size:14px}.nav a:hover{color:var(--tx)}
.hero{padding:64px 0 30px}
