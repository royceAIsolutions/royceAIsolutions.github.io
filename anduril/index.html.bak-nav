.btn.p{background:var(--acc);color:#04120a}.btn.s{border:1px solid var(--line);color:var(--tx)}
section{padding:44px 0;border-top:1px solid var(--line)}
h2{font-size:clamp(21px,3vw,30px);letter-spacing:-.02em;margin:0 0 8px}
