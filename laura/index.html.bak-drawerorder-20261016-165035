<script>
(function(){
  var grid=document.getElementById('grid');
  var cards=[].slice.call(grid.querySelectorAll('.bear'));
  var srch=document.getElementById('srch');
  var band='all';
  function apply(){
    var q=(srch.value||'').toLowerCase().trim();
    var shown=0;
    cards.forEach(function(c){
      var okB = band==='all' || c.getAttribute('data-band')===band;
      var hay=(c.getAttribute('data-hay')||'');
      var okQ = !q || hay.indexOf(q)>=0;
      var vis = okB && okQ;
      c.style.display = vis ? '' : 'none';
      if(vis) shown++;
    });
    var e=grid.querySelector('.empty');
    if(shown===0 && !e){
      e=document.createElement('div'); e.className='empty';
      e.textContent='No bears match that. Try another filter or search.';
      grid.appendChild(e);
    } else if(shown>0 && e){ e.remove(); }
  }
  [].slice.call(document.querySelectorAll('.fbtn')).forEach(function(b){
    b.addEventListener('click',function(){
      [].slice.call(document.querySelectorAll('.fbtn')).forEach(function(x){x.classList.remove('on');});
      b.classList.add('on'); band=b.getAttribute('data-band'); apply();
    });
  });
  srch.addEventListener('input',apply);
})();
</script>
