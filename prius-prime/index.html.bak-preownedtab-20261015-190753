<script>
(function(){
  function initMobileMenu(){
    var burger=document.getElementById('navBurger');
    if(!burger||document.getElementById('mobileMenu').dataset.mnInit)return;
    var menu=document.getElementById('mobileMenu');
    var backdrop=document.getElementById('mobileMenuBackdrop');
    var links=document.querySelector('.nav-links');
    if(links&&!menu.querySelector('a[data-mn]')){
      links.querySelectorAll('a').forEach(function(a){if(a.closest('#navLoginBtn'))return;if(a.classList.contains('nav-cta'))return;var h=a.getAttribute('href')||'';if(!a.classList.contains('nav-drawer-only')&&h!=='/products'&&h!=='/subscribe')return;var c=a.cloneNode(true);c.setAttribute('data-mn','1');menu.appendChild(c);});
    }
    var p=location.pathname;
    if(p.length>1&&p.endsWith('/'))p=p.slice(0,-1);
    menu.querySelectorAll('a').forEach(function(a){
      var h=a.getAttribute('href')||'';
      h=h.split('?')[0].split('#')[0];
      if(h.length>1&&h.endsWith('/'))h=h.slice(0,-1);
      if(h==='/'?p==='/':p.indexOf(h)===0)a.classList.add('active');
    });
    function open(){menu.classList.add('open');backdrop.classList.add('open');burger.classList.add('open');burger.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';}
    function close(){menu.classList.remove('open');backdrop.classList.remove('open');burger.classList.remove('open');burger.setAttribute('aria-expanded','false');document.body.style.overflow='';}
    burger.addEventListener('click',function(){menu.classList.contains('open')?close():open();});
    backdrop.addEventListener('click',close);
    document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});
    menu.querySelectorAll('a').forEach(function(a){a.addEventListener('click',close);});
    menu.dataset.mnInit='1';
  }
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',initMobileMenu);}else{initMobileMenu();}
})();

var q=document.getElementById('q'),fSrc=document.getElementById('fSrc'),fYear=document.getElementById('fYear'),
    fPrice=document.getElementById('fPrice'),fMiles=document.getElementById('fMiles'),
    sortEl=document.getElementById('sort'),grid=document.getElementById('grid'),
    resline=document.getElementById('resline'),empty=document.getElementById('empty');
var cards=[].slice.call(grid.querySelectorAll('.card'));

function inRange(val,spec){
  if(!spec)return true;
  var p=spec.split('-'),lo=parseFloat(p[0]),hi=parseFloat(p[1]);
  var v=parseFloat(val); if(isNaN(v)||v<=0){ if(lo<=0)return true; return false; }
  return v>=lo&&v<=hi;
}
function apply(){
  var term=q.value.trim().toLowerCase();
  var src=fSrc.value,yr=fYear.value,pr=fPrice.value,mi=fMiles.value;
  var shown=0;
  cards.forEach(function(c){
    var ok=true;
    if(term&&(c.dataset.title+' '+c.dataset.loc).indexOf(term)<0)ok=false;
    if(src&&c.dataset.src!==src)ok=false;
    if(yr&&c.dataset.year!==yr)ok=false;
    if(pr&&!inRange(c.dataset.price,pr))ok=false;
    if(mi&&!inRange(c.dataset.miles,mi))ok=false;
    c.style.display=ok?'':'none';
    if(ok)shown++;
  });
  var s=sortEl.value,get=function(c){return c;};
  var sorted=cards.slice().sort(function(a,b){
    var A,B;
    if(s==='score'){A=-parseFloat(a.dataset.score);B=-parseFloat(b.dataset.score);}
    else if(s==='price-asc'){A=parseFloat(a.dataset.price)||1e9;B=parseFloat(b.dataset.price)||1e9;}
    else if(s==='price-desc'){A=-(parseFloat(a.dataset.price)||0);B=-(parseFloat(b.dataset.price)||0);}
    else if(s==='miles-asc'){A=parseFloat(a.dataset.miles)||1e9;B=parseFloat(b.dataset.miles)||1e9;}
    else if(s==='year-desc'){A=-parseFloat(a.dataset.year);B=-parseFloat(b.dataset.year);}
    if(A!==B)return A-B;
    return (parseFloat(a.dataset.price)||0)-(parseFloat(b.dataset.price)||0);
  });
  sorted.forEach(function(c){grid.appendChild(c);});
  resline.innerHTML='Showing <b>'+shown+'</b> of <b>'+cards.length+'</b> live listings';
  empty.style.display=shown?'none':'block';
}
['input'].forEach(function(e){q.addEventListener(e,apply);});
[q,fSrc,fYear,fPrice,fMiles,sortEl].forEach(function(el){el.addEventListener('change',apply);});
q.addEventListener('keyup',apply);
document.getElementById('reset').addEventListener('click',function(){
  q.value='';fSrc.value='';fYear.value='';fPrice.value='';fMiles.value='';sortEl.value='score';apply();
});
apply();
</script>
